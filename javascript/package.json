{
  "name": "@crawlora-org/spotify",
  "version": "0.2.0",
  "description": "Crawlora Spotify API client with 38 endpoints for search, tracks, albums, artists, playlists, profiles, audiobooks, charts, and podcast shows and episodes",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=spotify-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-spotify/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "spotify", "spotify-api", "spotify-scraper", "spotify-data", "spotify-search", "spotify-tracks", "spotify-albums", "spotify-artists", "spotify-playlists", "spotify-profiles", "spotify-audiobooks", "spotify-charts", "spotify-podcast-shows-episodes"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-spotify",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
