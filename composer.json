{
  "name": "crawlora/spotify",
  "description": "Crawlora Spotify API client with 38 endpoints for search, tracks, albums, artists, playlists, profiles, audiobooks, charts, and podcast shows and episodes",
  "keywords": [
    "crawlora",
    "api-client",
    "web-scraping",
    "spotify",
    "search",
    "tracks",
    "albums",
    "artists",
    "playlists",
    "profiles",
    "audiobooks",
    "charts",
    "podcast-shows-episodes"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Spotify\\": "php/src/Crawlora/Spotify/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Spotify\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=spotify-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-spotify",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=spotify-php-api-docs"
  }
}
